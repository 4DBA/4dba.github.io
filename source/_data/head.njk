<style>
  .sidebar-nav {
    display: none !important;
  }
</style>
<script>
(function() {
  var path = window.location.pathname;
  var saved = localStorage.getItem('lang-preference');
  var isEn = path.startsWith('/en/');

  // 用户手动切换过，尊重选择
  if (saved) {
    if (saved === 'en' && !isEn) {
      window.location.href = '/en' + path;
    } else if (saved === 'zh-CN' && isEn) {
      window.location.href = path.replace(/^\/en/, '') || '/';
    }
  } else {
    // 首次访问：检测浏览器语言
    var lang = (navigator.language || navigator.userLanguage || '').toLowerCase();
    if (lang && !lang.startsWith('zh') && !isEn) {
      localStorage.setItem('lang-preference', 'en');
      window.location.href = '/en' + path;
    }
  }

  // 过滤文章列表：按链接路径中的 /en/ 区分语言
  document.addEventListener('DOMContentLoaded', function() {
    var posts = document.querySelectorAll('.post-title-link');
    posts.forEach(function(a) {
      var href = a.getAttribute('href') || '';
      var isEnPost = /\/\d{4}\/\d{2}\/\d{2}\/en\//.test(href);
      // 隐藏不属于当前语言的文章（整篇文章容器）
      if (isEn !== isEnPost) {
        var article = a.closest('article') || a.closest('.post-item') || a.closest('li');
        if (article) article.style.display = 'none';
      }
    });
  });
})();
</script>
