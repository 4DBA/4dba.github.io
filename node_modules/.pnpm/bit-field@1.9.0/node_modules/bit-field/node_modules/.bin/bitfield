#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/Cove/project/blog/node_modules/.pnpm/bit-field@1.9.0/node_modules/bit-field/node_modules:/home/Cove/project/blog/node_modules/.pnpm/bit-field@1.9.0/node_modules:/home/Cove/project/blog/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/Cove/project/blog/node_modules/.pnpm/bit-field@1.9.0/node_modules/bit-field/node_modules:/home/Cove/project/blog/node_modules/.pnpm/bit-field@1.9.0/node_modules:/home/Cove/project/blog/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/bitfield.js" "$@"
else
  exec node  "$basedir/../../bin/bitfield.js" "$@"
fi
